[Diamantbeinschienen]
Type=Hose
Desc=Funkelnde Beinschienen, die jeden Schritt im Kampf absichern.
ArmorPoints=6

[Netheritbeinschienen]
Type=Hose
Desc=Aus Netheritplatten gefertigt. Bietet maximalen Schutz für die Beine.
